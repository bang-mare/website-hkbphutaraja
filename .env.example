# ==============================================================================
# KONFIGURASI ENVIRONMENT - HKBP RESSORT HUTARAJA CMS
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# dan isi seluruh variabel ini di Vercel Project Settings > Environment Variables.
# ==============================================================================

# --- AI Studio / Aplikasi ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# --- Supabase (Client-side & Server-side) ---
# Dapatkan dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Service Role (HANYA Server / Vercel Functions - JANGAN pakai prefix VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive API (Service Account - HANYA Server / Vercel Functions) ---
# Isi dengan string JSON lengkap dari file key Service Account Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID Folder induk "HKBP-Hutaraja-Media" di Google Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=
